{
    "compilerOptions": {
        "allowJs": false,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": false,
        "jsx": "react",
        "lib": ["DOM", "ES2018"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": false,
        "outDir": "./dist",
        "resolveJsonModule": false,
        "rootDir": "./src",
        "skipLibCheck": true,
        "strict": true,
        "target": "esnext",
        "useDefineForClassFields": true
    },
    "include": ["src/ts/**/*"]
}
