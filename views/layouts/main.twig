<!DOCTYPE html>
<html {{ site.language_attributes }}>
{% include 'partials/head.twig' %}
<body class="{{ body_class }}">
	<div id="root" class="root">
		{% include 'components/global-header/global-header.twig' %}
		<main class="{{ main_class }}" role="main">
			{% block content %}{% endblock %}
			{% block sidebar %}{% endblock %}
		</main>
		{% include 'components/global-footer/global-footer.twig' %}
	</div><!-- #root -->
	{{ function('wp_footer') }}
	{% include 'partials/script.twig' %}
	{% block script %}{% endblock %}
</body>
</html>
