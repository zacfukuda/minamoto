<header id="global-header" class="global-header">
	<a href="{{ site.url }}" role="banner" rel="home" title="{{ site.name }}">
		<img src="{{ paths.relative_template_directory_uri }}/img/logo/normal.svg" alt="{{ site.name }}" width="128" height="128">
	</a>
	{% include 'components/global-header/global-header-navigation.twig' %}
	<svg class="hamburger hidden-lg toggle" width="24" height="16" viewBox="0 0 24 16" role="button" aria-expanded="false">
		<rect x="0" y="0" width="24" height="2" />
		<rect x="0" y="7" width="24" height="2" />
		<rect x="0" y="14" width="24" height="2" />
	</svg>
</header>
