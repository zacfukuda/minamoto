<article class="post-article is-{{ post.post_type }}">
	{% if post.thumbnail %}
		{% include 'components/post/post-thumbnail.twig' with { 'image': post.thumbnail, 'size': 'medium' } %}
	{% endif %}
	<h1>{{ post.title }}</h1>
	<p>Author: <a href="{{ post.author.path }}"> {{ post.author.name }} </a></p>
	<p>Date: {{ post.date }}</p>
	{% include 'components/post-category/post-category-list.twig' with { 'items': post.categories } %}
	{% include 'components/post-tag/post-tag-list.twig' with { 'items': post.tags } %}
	<div class="post-article-content">{{ post.content }}</div>
</article>
